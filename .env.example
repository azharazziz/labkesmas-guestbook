# --- Identitas aplikasi ---
APP_NAME="Balai Labkesmas Magelang"
APP_URL="https://bukutamu.labkesmas-magelang.go.id"
APP_TIMEZONE="Asia/Jakarta"

# --- Google Sheets ---
# ID diambil dari URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEETS_ID>/edit
GOOGLE_SHEETS_ID="1AbCdEf..."
GOOGLE_SHEET_NAME="Sheet1"

# --- Google Service Account ---
# Dari file JSON service account: client_email dan private_key
GOOGLE_SERVICE_ACCOUNT_EMAIL="buku-tamu@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# --- Konfigurasi formulir ---
# Nama tab opsional. Jika tidak ada, aplikasi memakai inferensi dari header data.
GOOGLE_CONFIG_SHEET_NAME="Konfigurasi Formulir"

# --- Admin ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
# Minimal 32 karakter acak; dipakai untuk menandatangani session cookie.
ADMIN_SESSION_SECRET="ganti-dengan-secret-acak-yang-panjang"
